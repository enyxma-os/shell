#!/usr/bin/env bash
set -euo pipefail
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 9>"$XDG_RUNTIME_DIR/enyxma-theme-apply.lock"
flock 9
mkdir -p "$HOME/.cache" "$HOME/.config/enyxma" "$HOME/.config/btop/themes" "$HOME/.config/yazi"
if [ ! -f "$HOME/.config/btop/btop.conf" ]; then
  cat > "$HOME/.config/btop/btop.conf" << 'EOF'
color_theme = "enyxma"
theme_background = False
EOF
fi
MODE="${1:-image}"
TARGET="${2:-}"
if [ -z "$TARGET" ]; then
  exit 1
fi

SHELL_DIR="${ENYXMA_SHELL_DIR:-$HOME/.local/share/enyxma-shell/runtime}"
CFG="$SHELL_DIR/matugen.toml"

safe_write() {
  local target="$1"
  if [ -L "$target" ] && [ ! -w "$target" ]; then
    cat >/dev/null
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  if ! cat > "$target" 2>/dev/null; then
    return 0
  fi
}

extract_vibrant_hex() {
  local img="$1"
  local cache="$HOME/.cache/enyxma-hex-cache.tsv"
  local sig=""
  sig=$(stat -c '%Y:%s' "$img" 2>/dev/null || echo "0")
  if [ -f "$cache" ]; then
    local hit=""
    hit=$(awk -F '\t' -v p="$img" -v s="$sig" '$1 == p && $2 == s { print $3; exit }' "$cache" 2>/dev/null || true)
    if [ -n "$hit" ]; then
      printf '%s\n' "$hit"
      return 0
    fi
  fi
  local hex=""
  hex=$(ffmpeg -v error -i "$img" -vf "scale=64:64" -f rawvideo -pix_fmt rgb24 - | od -An -tu1 -w3 -v | awk '
  NF == 3 {
    r = $1 / 255.0; g = $2 / 255.0; b = $3 / 255.0;
    max = r; if (g > max) max = g; if (b > max) max = b;
    min = r; if (g < min) min = g; if (b < min) min = b;
    d = max - min;
    s = (max == 0) ? 0 : d / max;
    v = max;
    if (s > 0.25 && v > 0.32 && v < 0.98) {
      if (max == r) h = (g - b) / d + (g < b ? 6 : 0);
      else if (max == g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h = h / 6.0;
      bucket = int(h * 12) % 12;
      w = (s * s * s) * (v * v);
      bw[bucket] += w;
      br[bucket] += $1 * w;
      bg[bucket] += $2 * w;
      bb[bucket] += $3 * w;
    }
  }
  END {
    best = -1; maxw = 0;
    for (i = 0; i < 12; i++) {
      if (bw[i] > maxw) { maxw = bw[i]; best = i; }
    }
    if (best >= 0 && maxw > 0) {
      printf "#%02x%02x%02x\n", int(br[best]/maxw), int(bg[best]/maxw), int(bb[best]/maxw);
    } else {
      print "#38bdf8";
    }
  }')
  printf '%s\t%s\t%s\n' "$img" "$sig" "$hex" >> "$cache" 2>/dev/null || true
  if [ -f "$cache" ] && [ "$(wc -l < "$cache" 2>/dev/null || echo 0)" -gt 120 ]; then
    tail -n 100 "$cache" > "$cache.tmp" 2>/dev/null && mv -f "$cache.tmp" "$cache" 2>/dev/null || true
  fi
  printf '%s\n' "$hex"
}

CUR_THEME="Bibata-Modern-Ice"
CUR_SIZE="24"
ICON_THEME="Papirus-Dark"

sync_hyprland() {
  if [ ! -f "$HOME/.config/hypr/colors.lua" ]; then
    return 0
  fi
  local act_a="" act_b="" inact="" rnd="" bsz="" gin="" gout="" c_t="" c_s=""
  eval "$(awk '
    match($0, /^[[:space:]]*(accent|accent_secondary|outline|cursor_theme)[[:space:]]*=[[:space:]]*"([^"]*)"/, m) {
      val[m[1]] = m[2]
    }
    match($0, /^[[:space:]]*(rounding|border_size|gaps_in|gaps_out|cursor_size)[[:space:]]*=[[:space:]]*([0-9]+)/, m) {
      val[m[1]] = m[2]
    }
    END {
      printf "act_a=%s\n",   ("\x27" val["accent"] "\x27")
      printf "act_b=%s\n",   ("\x27" val["accent_secondary"] "\x27")
      printf "inact=%s\n",   ("\x27" val["outline"] "\x27")
      printf "rnd=%s\n",     ("\x27" val["rounding"] "\x27")
      printf "bsz=%s\n",     ("\x27" val["border_size"] "\x27")
      printf "gin=%s\n",     ("\x27" val["gaps_in"] "\x27")
      printf "gout=%s\n",    ("\x27" val["gaps_out"] "\x27")
      printf "c_t=%s\n",     ("\x27" val["cursor_theme"] "\x27")
      printf "c_s=%s\n",     ("\x27" val["cursor_size"] "\x27")
    }
  ' "$HOME/.config/hypr/colors.lua")"
  [ -n "$c_t" ] && CUR_THEME="$c_t"
  [ -n "$c_s" ] && CUR_SIZE="$c_s"

  if command -v hyprctl >/dev/null 2>&1; then
    local lua_sync eval_res
    lua_sync="hl.config({ general = { gaps_in = ${gin:-5}, gaps_out = ${gout:-10}, border_size = ${bsz:-2}, col = { active_border = { colors = { \"${act_a:-rgba(7aa2f7ee)}\", \"${act_b:-rgba(bb9af7ee)}\" }, angle = 45 }, inactive_border = \"${inact:-rgba(3b4261aa)}\" } }, decoration = { rounding = ${rnd:-10} } })"
    eval_res=$(hyprctl eval "$lua_sync" 2>/dev/null || true)
    if [ "$eval_res" != "ok" ]; then
      [ -n "$act_a" ] && [ -n "$act_b" ] && hyprctl keyword general:col.active_border "$act_a $act_b 45deg" >/dev/null 2>&1 || true
      [ -n "$inact" ] && hyprctl keyword general:col.inactive_border "$inact" >/dev/null 2>&1 || true
      [ -n "$rnd" ] && hyprctl keyword decoration:rounding "$rnd" >/dev/null 2>&1 || true
      [ -n "$bsz" ] && hyprctl keyword general:border_size "$bsz" >/dev/null 2>&1 || true
      [ -n "$gin" ] && hyprctl keyword general:gaps_in "$gin" >/dev/null 2>&1 || true
      [ -n "$gout" ] && hyprctl keyword general:gaps_out "$gout" >/dev/null 2>&1 || true
    fi
    hyprctl setcursor "$CUR_THEME" "$CUR_SIZE" >/dev/null 2>&1 || true
  fi
}

apply_gotham_preset() {
  mkdir -p "$HOME/.cache" "$HOME/.config/hypr" "$HOME/.config/kitty" "$HOME/.config/foot" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" "$HOME/.config/btop/themes" "$HOME/.config/yazi"

  safe_write "$HOME/.config/hypr/colors.lua" << 'EOF'
-- Enyxma OS Gotham 2.0 Hyprland Paleti
return {
    preset = "gotham",
    rounding = 0,
    border_size = 2,
    gaps_in = 4,
    gaps_out = 8,
    cursor_theme = "Bibata-Modern-Classic",
    cursor_size = 24,
    accent = "rgba(f0b429ee)",
    accent_secondary = "rgba(f0b429ee)",
    accent_solid = "#f0b429",
    surface = "rgba(0b0d12ee)",
    surface_container = "rgba(11141cee)",
    outline = "rgba(222834cc)",
}
EOF
  sync_hyprland

  safe_write "$HOME/.config/kitty/kitty.conf" << 'EOF'
# Enyxma OS — Gotham 2.0 Kitty Yapilandirmasi
font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
font_size        11.5

background_opacity    0.88
