#!/usr/bin/env bash
# Enyxma Shot - Standalone Screenshot & Mockup Suite for Enyxma OS
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_DIR="$(dirname "$SCRIPT_DIR")"

LOCK="${XDG_RUNTIME_DIR:-/tmp}/enyxma-shot.lock"
if [ "$#" -eq 0 ] && ! flock -n "$LOCK" true 2>/dev/null; then
  pkill -f "$SHELL_DIR/modules/screenshot/shell.qml" 2>/dev/null || true
  exit 0
fi
exec flock -n -o "$LOCK" quickshell -p "$SHELL_DIR/modules/screenshot/shell.qml" "$@"
