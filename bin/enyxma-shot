#!/usr/bin/env bash
# Enyxma Shot - Standalone Screenshot & Mockup Suite for Enyxma OS
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_DIR="$(dirname "$SCRIPT_DIR")"

exec flock -n -o /tmp/enyxma-shot.lock quickshell -p "$SHELL_DIR/modules/screenshot/shell.qml" "$@"
